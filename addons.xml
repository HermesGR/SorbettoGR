<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.diamondwebtv" name="Diamond Web TV" version="1.2.0" provider-name="HermesGR">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
		<path>plugin.video.diamondwebtv-1.2.0.zip</path>
		<assets>
			<icon>plugin.video.diamondwebtv-icon.png</icon>
		</assets>
    <summary lang="el_GR">Diamond Web TV</summary>
    <summary lang="en_GB">Diamond Web TV</summary>
    <description lang="el_GR">Λίστα καναλιών που διαβάζεται απευθείας από το WordPress πρόσθετο Diamond Web TV Manager.</description>
    <description lang="en_GB">Channel list loaded directly from the Diamond Web TV Manager WordPress plugin.</description>
    <platform>all</platform>
  </extension>
</addon>

<addon id="repository.sorbetto" name="Sorbetto Repository" version="1.0.1" provider-name="Sorbetto">
	<requires>
		<import addon="xbmc.python" version="3.0.1"/>
	</requires>
	<extension point="xbmc.addon.repository" name="Sorbetto Repository">
		<dir>
			<info compressed="false">https://hermesgr.github.io/SorbettoGR/addons.xml</info>
			<checksum>https://hermesgr.github.io/SorbettoGR/addons.xml.md5</checksum>
			<datadir zip="true">https://hermesgr.github.io/SorbettoGR/</datadir>
			<hashes>false</hashes>
		</dir>
	</extension>
	<!-- Μικρή υπηρεσία: σε κάθε εκκίνηση (και αμέσως μετά από ενημέρωση του αποθετηρίου) «δένει»
	     το skin και τον βοηθό με αυτό το αποθετήριο, ώστε να ενημερώνονται αυτόματα. -->
	<extension point="xbmc.service" library="service.py" start="startup"/>
	<extension point="xbmc.addon.metadata">
		<path>repository.sorbetto-1.0.1.zip</path>
		<assets>
			<icon>repository.sorbetto-icon.png</icon>
		</assets>
		<summary lang="el_GR">Αποθετήριο του Sorbetto build: αυτόματες ενημερώσεις για το skin και τα πρόσθετά του.</summary>
		<summary lang="en_GB">Sorbetto build repository: automatic updates for the skin and its add-ons.</summary>
		<description lang="el_GR">Σε κάθε εκκίνηση του Kodi ελέγχεται για νέες εκδόσεις του Sorbetto skin και του βοηθού του, και εγκαθίστανται αυτόματα.</description>
		<description lang="en_GB">On every Kodi start it checks for new versions of the Sorbetto skin and its helper, and installs them automatically.</description>
		<platform>all</platform>
		<license>GPL-2.0-only</license>
	</extension>
</addon>

<addon id="script.sorbetto.helper" name="Sorbetto Helper" version="1.3.18" provider-name="Sorbetto">
	<requires>
		<import addon="xbmc.python" version="3.0.1"/>
		<import addon="service.subtitles.opensubtitles" version="5.0.0"/>
	</requires>
	<extension point="xbmc.python.pluginsource" library="default.py">
		<provides>executable</provides>
	</extension>
	<extension point="xbmc.service" library="service.py" start="startup"/>
	<extension point="xbmc.addon.metadata">
		<path>script.sorbetto.helper-1.3.18.zip</path>
		<assets>
			<icon>script.sorbetto.helper-icon.png</icon>
		</assets>
		<summary lang="el_GR">Βοηθός του Sorbetto build: φέρνει online το μενού και τα φόντα της αρχικής.</summary>
		<summary lang="en_GB">Sorbetto build helper: loads the home menu online.</summary>
		<description lang="el_GR">Σε κάθε εκκίνηση του Kodi κατεβάζει το μενού της αρχικής από τη σελίδα διαχείρισης και ζητά έλεγχο ενημερώσεων. Τρέχει μία φορά και κλείνει.</description>
		<description lang="en_GB">On every Kodi start it downloads the home menu from the management page and asks for an update check. It runs once and exits.</description>
		<platform>all</platform>
		<license>GPL-2.0-only</license>
	</extension>
</addon>
</addons>
